{
  "name": "jcut-ai-app",
  "productName": "JCut AI",
  "version": "0.1.0",
  "description": "An AI video editor that understands your footage and cuts it for you.",
  "author": "JCut.AI",
  "homepage": "https://jcut.ai",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/preload.cjs && wait-on tcp:5173 && ELECTRON_RUN_AS_NODE= electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/preload.cjs",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "framer-motion": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ai.jcut.app",
    "productName": "JCut AI",
    "copyright": "© 2026 JCut.AI",
    "directories": {
      "output": "release",
      "buildResources": "../build"
    },
    "files": [
      "dist-web/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "backend/dist"
      },
      {
        "from": "../node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../SYSTEM.md",
        "to": "backend/SYSTEM.md"
      },
      {
        "from": "../kb",
        "to": "backend/kb"
      },
      {
        "from": "../build/icon.png",
        "to": "backend/icon.png"
      },
      {
        "from": "../bin",
        "to": "backend/bin"
      }
    ],
    "mac": {
      "icon": "../build/icon.icns",
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "JCut.AI does not use the camera.",
        "CFBundleDisplayName": "JCut AI",
        "LSApplicationCategoryType": "public.app-category.video"
      }
    },
    "dmg": {
      "title": "JCut AI ${version}",
      "artifactName": "JCutAI-${version}-${arch}.dmg",
      "icon": "../build/icon.icns",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
